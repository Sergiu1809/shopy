# Copy to .env (git-ignored) and fill in real keys as the phases need them.
# Placeholders only: never commit a real secret (PATTERN-013).

# Postgres (local Compose db service; not in brief §18, needed so Compose has no hard-coded password)
POSTGRES_USER=shopy
POSTGRES_PASSWORD=change-me
POSTGRES_DB=shopy

# Database
DATABASE_URL=postgresql+asyncpg://shopy:change-me@db:5432/shopy

# Auth
JWT_SECRET=change-me

# LLM (D-007)
ANTHROPIC_API_KEY=change-me
LLM_MODEL=claude-haiku-5-5

# OpenAI: speech-to-text and embeddings (D-009)
OPENAI_API_KEY=change-me
# Open: Q-004 (STT model)
STT_MODEL=
EMBEDDING_MODEL=text-embedding-3-small

# Azure Speech: text-to-speech (D-009)
AZURE_SPEECH_KEY=change-me
# Not decided yet
AZURE_SPEECH_REGION=
# Open: Q-003 (Azure voice)
TTS_VOICE=

# Stripe (test mode only)
STRIPE_SECRET_KEY=change-me
STRIPE_PUBLISHABLE_KEY=change-me
STRIPE_WEBHOOK_SECRET=change-me

# Object storage (local: MinIO; its root user/password are S3_ACCESS_KEY / S3_SECRET_KEY, min. 8 chars)
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=change-me
S3_SECRET_KEY=change-me
S3_BUCKET=shopy-images

# Mail (local: Mailpit over SMTP; production provider not decided yet)
MAIL_PROVIDER=
RESEND_API_KEY=
MAIL_FROM=
SMTP_HOST=mailpit
SMTP_PORT=1025

# WebAuthn and app origin (iPhone testing: set to the tunnel host)
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=Shopy
WEBAUTHN_ORIGIN=http://localhost:5173
APP_ORIGIN=http://localhost:5173

# Langfuse tracing
LANGFUSE_PUBLIC_KEY=change-me
LANGFUSE_SECRET_KEY=change-me
LANGFUSE_HOST=

# Cost control
# Open: Q-013 (daily cost cap)
DAILY_COST_CAP_EUR=
# Not decided yet
USER_DAILY_MESSAGE_CAP=
# PRICE_*: unit prices per provider; names defined with the usage ledger in P3

# Seed users (P1)
SEED_ADMIN_PASSWORD=change-me
SEED_CUSTOMER_PASSWORD=change-me
